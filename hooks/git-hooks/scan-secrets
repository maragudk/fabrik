#!/bin/bash
# Scans what is about to be committed for secrets: the added lines of the
# staged diff (`git diff --cached`, which honours GIT_INDEX_FILE), plus staged
# files named exactly `.env`. Files git treats as binary are skipped.
#
# Exits 0 when clean, 1 when it finds something or cannot scan (fail closed).
# Findings are printed redacted, never in full.
#
# Portable to macOS (bash 3.2, BSD tools) and Linux (GNU grep, mawk): grep -E
# only, no awk interval expressions, no bash 4 features, no GNU-only flags.

# Byte semantics for grep/awk: no "illegal byte sequence" errors on non-UTF-8
# content, and GNU grep won't switch to "Binary file matches" mode.
LC_ALL=C
export LC_ALL
# GIT_DIFF_OPTS can add context lines despite --unified=0.
unset GIT_DIFF_OPTS

fail_closed() {
  {
    echo "fabrik secret scan: $1"
    echo "The commit is blocked because the staged changes could not be scanned for secrets. Fix the error and commit again."
    echo "Never bypass this check with --no-verify. If you can't fix the error, stop and ask the user."
  } >&2
  exit 1
}

tmp=$(mktemp -d "${TMPDIR:-/tmp}/fabrik-scan.XXXXXX") || fail_closed "could not create a temporary directory"
trap 'rm -rf "$tmp"' EXIT

# Each finding is one line: <record number in meta, or 0><TAB><location><TAB><detector><TAB><redacted match>
: > "$tmp/findings" || fail_closed "could not write to $tmp"

# 1. Files named exactly .env, added, copied, or renamed into place.
git diff --cached --name-only -z --diff-filter=ACR > "$tmp/names" ||
  fail_closed "\`git diff --cached --name-only\` failed"
while IFS= read -r -d '' path; do
  case "$path" in
    .env | */.env)
      # Tabs and newlines in the path would break the findings format.
      printf '0\t%s\t.env file\t-\n' "$(printf '%s' "$path" | tr '\t\n' '??')" >> "$tmp/findings" ||
        fail_closed "could not write to $tmp"
      ;;
  esac
done < "$tmp/names"

# 2. Added lines of the staged diff. awk writes two line-aligned files:
#    meta:    <path><TAB><line number in the new file>
#    content: the added line, padded with a space on both sides so that every
#             detector can require a non-key character before and after a match.
# Only lines containing a detector keyword are written, which keeps the regex
# passes fast on big diffs. Hunk line counts are tracked so that an added line
# starting with "++" is never mistaken for a "+++" file header, and any line
# the parser doesn't understand fails the scan instead of being skipped.
# NUL bytes become spaces first: BSD awk would silently cut the line there.
: > "$tmp/meta"
: > "$tmp/content"
(
  set -o pipefail
  git -c core.quotePath=false diff --cached --no-color --no-ext-diff --no-textconv \
    --unified=0 --inter-hunk-context=0 --src-prefix=a/ --dst-prefix=b/ |
    tr '\000' ' ' |
    awk -v meta="$tmp/meta" -v content="$tmp/content" '
      inhunk {
        c = substr($0, 1, 1)
        if (c == "+") {
          if ($0 ~ /sk-|AKIA|ASIA|AIza|[Ss][Ee][Cc][Rr][Ee][Tt]/) {
            print file "\t" line > meta
            print " " substr($0, 2) " " > content
            wrote = 1
          }
          line++
          newleft--
        } else if (c == "-") {
          oldleft--
        } else if (c == " " || $0 == "") {
          line++
          newleft--
          oldleft--
        } else if (c != "\\") {
          exit 2
        }
        if (newleft <= 0 && oldleft <= 0) inhunk = 0
        next
      }
      /^\+\+\+ / {
        file = substr($0, 5)
        sub(/\t$/, "", file)
        if (substr(file, 1, 2) == "b/") file = substr(file, 3)
        else if (substr(file, 1, 3) == "\"b/") file = "\"" substr(file, 4)
        next
      }
      /^@@ / {
        no = split($2, o, ",")
        nn = split($3, n, ",")
        oldleft = (no > 1) ? o[2] + 0 : 1
        newleft = (nn > 1) ? n[2] + 0 : 1
        line = substr(n[1], 2) + 0
        inhunk = (oldleft > 0 || newleft > 0)
        next
      }
      END { if (wrote && (close(meta) != 0 || close(content) != 0)) exit 2 }
    '
) || fail_closed "could not read the staged diff (\`git diff --cached\` or its parser failed)"

# 3. Detectors. Each runs one grep over the candidate lines.
#    $1 detector name, $2 extended regex, $3 how to cut the key out of the match
#    (bounded: drop the boundary character on each side; aws-secret: the 40
#    characters before the trailing boundary; none: the match is the key),
#    $4 extra grep flags.
detect() {
  [ -s "$tmp/content" ] || return 0
  grep -anoE $4 -- "$2" "$tmp/content" > "$tmp/hits"
  [ $? -gt 1 ] && fail_closed "grep failed while checking for: $1"
  while IFS= read -r hit; do
    n=${hit%%:*}
    key=${hit#*:}
    shown=8
    case "$3" in
      bounded) key=${key#?}; key=${key%?} ;;
      # No fixed prefix, so every character shown is secret: show fewer.
      aws-secret) key=${key%?}; key=${key:$((${#key} - 40))}; shown=4 ;;
    esac
    printf '%s\t-\t%s\t%s\n' "$n" "$1" "${key:0:$shown}…" >> "$tmp/findings" ||
      fail_closed "could not write to $tmp"
  done < "$tmp/hits"
}

# Anthropic: sk-ant-api03-, sk-ant-admin01-, sk-ant-oat01- etc. Real keys have
# 95 characters after the version; 80+ rules out placeholders like sk-ant-xxx.
detect "Anthropic API key" 'sk-ant-[a-z]+[0-9]{2}-[A-Za-z0-9_-]{80,}' none
# OpenAI project, service account, and admin keys (116+ characters after the
# prefix), then the legacy sk- + 48 alphanumerics. The legacy pattern cannot
# match inside an sk-ant-/sk-proj- key: the hyphen after "sk-ant" or
# "sk-proj" isn't alphanumeric, and the left boundary blocks mid-key matches.
detect "OpenAI API key" 'sk-(proj|svcacct|admin)-[A-Za-z0-9_-]{80,}' none
detect "OpenAI API key" '[^A-Za-z0-9_-]sk-[A-Za-z0-9]{48}[^A-Za-z0-9_-]' bounded
# AWS access key IDs, word-bounded like \b.
detect "AWS access key ID" '[^A-Za-z0-9_](AKIA|ASIA)[A-Z0-9]{16}[^A-Za-z0-9_]' bounded
# AWS secret access keys have no prefix, so only flag 40 base64 characters when
# they closely follow a name like aws_secret_access_key, SecretAccessKey, or
# AWS_SECRET_KEY on the same line: up to 6 characters such as =, :, quotes,
# brackets, spaces, or a tag's > in between.
detect "AWS secret access key" \
  '(aws[_.-]?secret[_.-]?(access[_.-]?)?key|secret[_.-]?access[_.-]?key)[^A-Za-z0-9/+]{1,6}[A-Za-z0-9/+]{40}[^A-Za-z0-9/+=]' \
  aws-secret -i
# Google API keys: AIza + 35 characters.
detect "Google API key" '[^A-Za-z0-9_-]AIza[0-9A-Za-z_-]{35}[^A-Za-z0-9_-]' bounded

[ -s "$tmp/findings" ] || exit 0

# 4. Report. Resolve record numbers to path:line, in diff order.
{
  echo "fabrik secret scan: commit blocked. The staged changes contain what looks like secrets:"
  echo
  sort -t "$(printf '\t')" -k1,1n "$tmp/findings" |
    awk -F '\t' -v meta="$tmp/meta" '
      BEGIN { while ((getline m < meta) > 0) { i++; split(m, f, "\t"); loc[i] = f[1] ":" f[2] } }
      $1 == 0 { print "  " $2 "  " $3; next }
      { print "  " loc[$1] "  " $3 "  " $4 }
    '
  echo
  echo "Remove each secret from the file and load it from an environment variable or a gitignored file instead."
  echo "Never commit a .env file: unstage it with \`git rm --cached <path>\` and add it to .gitignore."
  echo "Then stage your changes again and retry the commit."
  echo "Never bypass this check with --no-verify. If you believe a finding is a false positive, stop and ask the user."
} >&2
exit 1
